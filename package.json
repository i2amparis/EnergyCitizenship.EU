{
	"name": "energycitizenship-eu",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"description": "EnergyCitizenship.eu: a learning tool and data viewer on citizen participation in the European energy transition.",
	"license": "SEE LICENSE IN LICENSE",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev --port 3030",
		"build": "vite build",
		"preview": "vite preview --port 4173",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"geo": "node scripts/build-basemap.js",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"packageManager": "npm@11.19.1",
	"engines": {
		"node": ">=22.12",
		"npm": ">=11.19"
	},
	"volta": {
		"node": "24.12.0",
		"npm": "11.19.1"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"d3-array": "^3.2.5",
		"d3-geo": "^3.1.2",
		"d3-scale": "^4.0.3",
		"d3-shape": "^3.2.1",
		"maplibre-gl": "^6.19.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/d3-array": "^3.2.2",
		"@types/d3-geo": "^3.1.1",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^24.19.2",
		"@types/topojson-client": "^3.1.5",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.59.0",
		"svelte-check": "^4.7.0",
		"tailwindcss": "^4.3.0",
		"topojson-client": "^3.1.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"world-atlas": "^2.0.2"
	}
}
